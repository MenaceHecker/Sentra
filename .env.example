# ---- Database ----
DATABASE_URL=postgresql+psycopg://sentra:sentra@localhost:5432/sentra

# ---- Auth / Sessions ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- LLM Provider ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY is required to actually run an investigation (POST
# .../investigate calls OpenAI with native tool-calling, there's no
# fallback for that). It's optional only for runbook embeddings: without
# it, those fall back to a deterministic hash-based embedding
# (app/embeddings.py) so search still works out of the box, just without
# real semantic understanding.

# ---- Simulated system ----
SIM_SYSTEM_BASE_URL=http://localhost:9000

# ---- App ----
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000