# ---- Database ----
DATABASE_URL=postgresql+psycopg://sentra:sentra@localhost:5432/sentra

# ---- Auth / Sessions ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- LLM Provider ----
# Pick one provider for LLM_PROVIDER: openai or gemini. Whichever you pick,
# its *_API_KEY is required to actually run an investigation (POST
# .../investigate calls it with native tool-calling, there's no fallback
# for that). OPENAI_API_KEY is also used for embeddings if set, but that
# one's optional: without it, embeddings fall back to a deterministic
# hash-based embedding (app/embeddings.py), so runbook search still works
# out of the box, just without real semantic understanding.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Simulated system ----
SIM_SYSTEM_BASE_URL=http://localhost:9000

# ---- App ----
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000